'use strict';
// write your code here
// Отримуємо всі елементи з класом 'population'
var populationElements = document.querySelectorAll('.population');
// Перетворюємо їхній текстовий вміст у числа
var populations = Array.from(populationElements).map(function(el) {
    return parseInt(el.textContent.replace(/,/g, ''), 10);
}).filter(function(num) {
    return !isNaN(num);
}); // Перевірка, чи це дійсні числа
// Обчислюємо загальну кількість та середнє значення
var total = populations.reduce(function(sum, num) {
    return sum + num;
}, 0);
var average = Math.round(total / populations.length);
// Форматуємо числа з роздільниками тисяч
var formattedTotal = total.toLocaleString();
var formattedAverage = average.toLocaleString();
// Вставляємо результат у відповідні спани
document.querySelector('.total-population').textContent = formattedTotal;
document.querySelector('.average-population').textContent = formattedAverage;

